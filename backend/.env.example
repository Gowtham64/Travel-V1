# Copy this file to .env and fill in your free API keys.

# OpenRouteService - free key at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Mapbox token - used for traffic-aware routing (driving-traffic) + geocoding.
# Free token at https://account.mapbox.com/. If unset, the app falls back to
# OpenRouteService (routing) and Nominatim (geocoding).
MAPBOX_TOKEN=

# TollGuru - free key at https://tollguru.com/dashboard
# (personal email = 15 requests/day, business email = 150 requests/day)
TOLLGURU_API_KEY=

# Port the backend listens on (optional)
PORT=3000

# Supabase (backend uses these for auth verification + route cache)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# AI provider key (optional — enables the AI itinerary/recommend/ask features).
# One of GEMINI_API_KEY / GROQ_API_KEY / OPENROUTER_API_KEY depending on provider.
GEMINI_API_KEY=
