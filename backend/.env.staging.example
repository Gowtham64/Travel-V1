# ============================================================================
# STAGING backend environment — copy to the STAGING Render service's env vars.
# MUST point at the SEPARATE staging Supabase project, never production.
# ============================================================================
APP_ENV=staging

# Staging Supabase project (create a new free project; do NOT reuse prod).
SUPABASE_URL=https://YOUR-STAGING-REF.supabase.co
SUPABASE_ANON_KEY=YOUR_STAGING_ANON_KEY

# Third-party keys — prefer SEPARATE/sandbox keys for staging where available,
# so staging never consumes prod quotas or triggers real side effects.
ORS_API_KEY=
MAPBOX_TOKEN=
TOLLGURU_API_KEY=

PORT=
