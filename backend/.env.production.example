# ============================================================================
# PRODUCTION backend environment — matches the live Render service
# (travel-v1-mzia.onrender.com). Points at the PRODUCTION Supabase project.
# Keep these values only in the production Render service's env settings.
# ============================================================================
APP_ENV=production

# Production Supabase project.
SUPABASE_URL=https://dtemayjpttktntooxraa.supabase.co
SUPABASE_ANON_KEY=YOUR_PRODUCTION_ANON_KEY

ORS_API_KEY=
MAPBOX_TOKEN=
TOLLGURU_API_KEY=

PORT=

# Exact browser origins; keep this limited to deployed app domains.
ALLOWED_ORIGINS=https://voyplan.in,https://www.voyplan.in

# Server-only provider credentials. Never add these to Flutter build defines.
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
