# VoyPlan AI Engineering System Environment Configuration
# Copy to .env for local testing - NEVER commit .env to Git

# GitHub API credentials
GITHUB_TOKEN=

# AI Model Provider Configuration
# Supported: 'ollama' | 'openai' | 'gemini' | 'anthropic'
MODEL_PROVIDER=ollama
MODEL_NAME=qwen2.5-coder:latest

# Cloud Provider Keys (optional if using local Ollama)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Local Ollama endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Environments
DATABASE_URL=
STAGING_URL=https://staging.voyplan.in
PRODUCTION_URL=https://voyplan.in
STAGING_BACKEND_URL=https://voyplan-staging.onrender.com

# Cost & Execution Controls
MAX_QA_RETRIES=3
MAX_AGENT_ITERATIONS=20
COMMAND_TIMEOUT=300
