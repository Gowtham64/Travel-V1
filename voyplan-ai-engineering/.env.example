# VoyPlan AI Engineering System Environment Configuration
# Copy to .env for local testing - NEVER commit .env to Git

# GitHub API credentials
GITHUB_TOKEN=

# AI Model Provider Configuration
# By default, system uses the Role-Based Free Tier Matrix:
# CEO Agent: Gemini 1.5 Pro / Flash (Google AI Studio Free Tier)
# R&D Agent: Gemini 1.5 Flash (Google AI Studio Free Tier)
# Coding Agent: Qwen 2.5 Coder 32B or DeepSeek-V3 (Groq Cloud Free API / OpenRouter)
# Testing Agent: DeepSeek-R1 (Distill 70B/14B) (Groq / Local via Ollama)
# Security Agent: Llama 3.3 70B (Groq Cloud Free Tier)
# Deployment Agent: Llama 3.1 8B (Ollama Local / Groq Free)

MODEL_PROVIDER=gemini
MODEL_NAME=gemini-flash-latest

# Free Tier Provider Keys
GEMINI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Local Ollama endpoint (Optional)
OLLAMA_BASE_URL=http://localhost:11434

# Environments
DATABASE_URL=
STAGING_URL=https://staging.voyplan.in
PRODUCTION_URL=https://voyplan.in
STAGING_BACKEND_URL=https://voyplan-staging.onrender.com

# Cost & Execution Controls
MAX_QA_RETRIES=3
MAX_AGENT_ITERATIONS=20
COMMAND_TIMEOUT=300
